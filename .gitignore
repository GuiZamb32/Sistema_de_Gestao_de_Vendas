# ============================================================
# SISTEMA DE GESTÃO DE VENDAS
# Git Ignore
# ============================================================


# ============================================================
# NODE / REACT / VITE
# ============================================================

node_modules/
dist/
dist-ssr/
*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ============================================================
# PYTHON
# ============================================================

__pycache__/
*.py[cod]
*$py.class

# Ambiente virtual
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Arquivos de distribuição Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Arquivos de instalação
*.egg
*.egg-info/
.installed.cfg
*.egg

# Ferramentas de teste
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/


# ============================================================
# VARIÁVEIS DE AMBIENTE / SEGREDOS
# ============================================================

.env
.env.*
!.env.example

# Possíveis arquivos com credenciais
*.pem
*.key
*.secret


# ============================================================
# LOGS
# ============================================================

logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ============================================================
# EDITORES / IDEs
# ============================================================

.vscode/*
!.vscode/extensions.json

.idea/
*.iml

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# ============================================================
# SISTEMA OPERACIONAL
# ============================================================

.DS_Store
Thumbs.db
desktop.ini


# ============================================================
# BANCO DE DADOS LOCAL / TEMPORÁRIOS
# ============================================================

*.sqlite
*.sqlite3
*.db

# Dumps locais do banco
*.sql


# ============================================================
# ARQUIVOS TEMPORÁRIOS
# ============================================================

*.tmp
*.temp
*.bak
*.swp
*.swo
*~


# ============================================================
# COBERTURA / CACHE DE FERRAMENTAS
# ============================================================

.cache/
.parcel-cache/
.vite/